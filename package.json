{
  "author": "Involvex",
  "bin": {
    "yt-dlp-cli": "./bin/yt-dlp.js"
  },
  "bugs": {
    "url": "https://github.com/involvex/yt-dlp/issues"
  },
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "dependencies": {},
  "description": "A feature-rich command-line audio/video downloader - Node.js wrapper with TypeScript API",
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "files": [
    "dist",
    "bin/yt-dlp.js",
    "binaries/any",
    "completions",
    "scripts/postinstall.js"
  ],
  "homepage": "https://github.com/involvex/yt-dlp#readme",
  "keywords": [
    "yt-dlp",
    "youtube-dl",
    "video-downloader",
    "audio-downloader",
    "youtube",
    "cli",
    "typescript",
    "powershell"
  ],
  "license": "Unlicense",
  "main": "./dist/index.js",
  "name": "@involvex/yt-dlp",
  "optionalDependencies": {
    "@involvex/yt-dlp-binary-windows-x64": "2026.8.22",
    "@involvex/yt-dlp-binary-windows-x86": "2026.8.22",
    "@involvex/yt-dlp-binary-windows-arm64": "2026.8.22",
    "@involvex/yt-dlp-binary-linux-x64": "2026.8.22",
    "@involvex/yt-dlp-binary-linux-arm64": "2026.8.22",
    "@involvex/yt-dlp-binary-linux-musl-x64": "2026.8.22",
    "@involvex/yt-dlp-binary-macos-universal2": "2026.8.22"
  },
  "os": [
    "win32",
    "darwin",
    "linux",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/involvex/yt-dlp"
  },
  "scripts": {
    "build": "bun run build:ts && bun run build:bin",
    "build:bin": "bun run scripts/build-binaries.ts",
    "build:binpkg": "bun run scripts/build-binary-packages.ts",
    "build:ts": "tsc",
    "dev": "bun --watch src/index.ts",
    "generate-completion": "bun run scripts/generate-completion.ts",
    "lint": "eslint src --ext .ts",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "bun run build && bun run build:binpkg && node scripts/verify-package.mjs",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.check.json",
    "verify": "node scripts/verify-package.mjs",
    "release": "bun scripts/publish.ts"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "2026.8.22"
}
